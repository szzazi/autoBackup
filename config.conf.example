############################################
# Configuration for Auto Backup
# Place this file next to startBackup.sh or
# specify it with --config /path/to/config.conf
############################################

##########################
# === PROGRAM SETTINGS ===
##########################

# Main directory of the backup script.
# This should contain sourceList.txt, excludeList.txt, etc.
# Usually the same directory as startBackup.sh
PROGRAM_DIR="/usr/local/bin/autoBackup"

# Path to file containing list of source directories to back up.
# Each line should be an absolute path.
# Example contents:
# /home/user/Documents
# /etc
SOURCE_DIRS_LIST="$PROGRAM_DIR/sourceList.txt"

# Path to file containing exclude rules for rsync.
# Each line can be a file pattern or directory name to ignore.
# Example contents:
# *.tmp
# node_modules/
EXCLUDE_LIST="$PROGRAM_DIR/excludeList.txt"

###########################
# === MYSQL BACKUP SETTINGS (OPTIONAL) ===
#
# Enable or disable MySQL database backup:
# Set MYSQL_BACKUP_ENABLED="true" to include MySQL dumps in the backup zip.
# Set MYSQL_BACKUP_ENABLED="false" to skip database backup.
#
# MySQL backup will export each table's data to a separate file, and the schema/meta info to one file per database.
# You can exclude system or unwanted databases using MYSQL_EXCLUDE_DBS (space-separated list).
# Default excluded: mysql phpmyadmin
###########################

#  Set to "true" to enable MySQL database backup, "false" to disable.
MYSQL_BACKUP_ENABLED="false" 

# MySQL user with privileges to read all databases/tables to be backed up.
MYSQL_USERNAME="backupuser"

# Password for the above MySQL user.
MYSQL_PASSWORD="yourStrongPassword"

# Hostname or IP address of the MySQL server.
# Default: localhost
MYSQL_HOST="localhost"

# MYSQL_PORT: Port number for MySQL server 
# Default: 3306
MYSQL_PORT="3306"

# Space-separated list of databases to exclude from backup.
# Default: mysql phpmyadmin performance_schema
MYSQL_EXCLUDE_DBS="mysql phpmyadmin"

# === SAMBA/CIFS SETTINGS ===
###########################

# IP address or hostname of the Samba server.
# This is where the backup will be mounted and copied to.
# Example: 192.168.1.10 or backups.local
SAMBA_SERVER="192.168.1.10"

# Shared folder on the Samba server to mount.
# Must match a configured share name on the server.
# Example: "/backupTarget" maps to //[server]/backupTarget
SAMBA_FOLDER="/backupTarget"

# SAMBA_VERSION: Samba protocol version to use for mounting. Examples: 1.0 (old), 2.0, 3.0 (recommended if supported by server)
SAMBA_VERSION="1.0"  # See above: Samba protocol version

# === WAKE-ON-LAN (OPTIONAL) ===
# If enabled, the remote is pinged before mounting. If it does not answer,
# a WOL magic packet is sent and pinging continues until it answers or the
# timeout expires (then an error is reported to Sentry and the script exits).
# CLI: --wol --wol-mac <mac> --wol-ping-ip <ip> --wol-timeout <sec>
WOL_ENABLED="false"
# MAC address of the remote machine (AA:BB:CC:DD:EE:FF or AA-BB-CC-DD-EE-FF)
WOL_MAC="AA:BB:CC:DD:EE:FF"
# IP to ping for availability. If empty, SAMBA_SERVER is used.
WOL_PING_IP=""
# Max seconds to wait (real time) for the host to answer after the WOL packet
WOL_WAKEUP_TIMEOUT_SEC="120"
# Optional network interface (e.g. enp3s0). If set and etherwake is installed,
# etherwake is used on this interface (needs root). Otherwise wakeonlan or python3 broadcast.
WOL_INTERFACE=""

# === MOUNT RETRY ===
# A freshly woken host may answer ping before the Samba share is ready,
# so the mount is retried. After the last failure an error is reported to Sentry.
MOUNT_RETRIES="5"
MOUNT_RETRY_DELAY_SEC="10"

# === SENTRY ERROR REPORTING (OPTIONAL) ===
# Every failure (WOL, mount, copy, MySQL dump, compression, upload, unmount,
# interruption, unexpected exit) is sent to Sentry.
# Get the DSN from Sentry: Project Settings > Client Keys (DSN). Leave empty to disable.
# Uses sentry-cli if installed, otherwise curl.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"

# === Optional: credentials (can be overridden by CLI) ===

# Samba username to access the shared folder.
# You can override this with: --user <username>
SAMBA_USERNAME="backupuser"

# Samba password associated with the above username.
# You can override this with: --pass <password>
SAMBA_PASSWORD="yourStrongPassword"

###########################
# Notes:
# - Do not enclose values in quotes unless necessary (as above).
# - Avoid trailing slashes in SAMBA_FOLDER.
# - Do NOT use credentials file (this config works without it).
# - Any CLI parameter (user/pass/config) overrides these.
#
# Example usage overriding username & password:
# ./startBackup.sh --user newuser --pass newpassword
###########################
